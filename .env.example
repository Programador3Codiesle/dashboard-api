# ============================================
# CONFIGURACIÓN DEL BACKEND - Intranet Postventa
# ============================================
# Copia este archivo según tu entorno:
# - Desarrollo local (dev): .env.local
# - Servidor de desarrollo: .env

# ============================================
# BASE DE DATOS (SQL Server)
# ============================================
# Formato: sqlserver://HOST:PORT;database=DB_NAME;user=USER;password=PASSWORD;encrypt=false;trustServerCertificate=true
DATABASE_URL="sqlserver://localhost:1433;database=your_database;user=your_user;password=your_password;encrypt=false;trustServerCertificate=true"

# ============================================
# JWT AUTHENTICATION
# ============================================
# IMPORTANTE: Cambiar esta clave en producción por una clave segura única
# Puedes generar una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_TOKEN_SECRET=your_super_secret_key_change_in_production

# Token de refresh (opcional, descomentar si se necesita)
# JWT_REFRESH_TOKEN_SECRET=your_refresh_secret_key_change_in_production

# ============================================
# SERVIDOR
# ============================================
PORT=4000
NODE_ENV=development

# Origen del frontend permitido por CORS (sin trailing slash)
CORS_ORIGIN=http://localhost:3000

# URL pública del backend (correos: enlaces a /administracion/responder, adjuntos)
APP_URL=http://localhost:4000

# URL del frontend (redirecciones tras autorización por correo)
FRONTEND_URL=http://localhost:3000

# URL pública preferida para enlaces en correos del cotizador (PDF, imágenes).
# Si está vacío, se usa FRONTEND_URL y luego BACKEND_PUBLIC_URL.
# APP_PUBLIC_URL=

# URL pública del backend si los enlaces del correo deben apuntar al API
# BACKEND_PUBLIC_URL=

# JWT para tokens en enlaces de correo (gestión compras, ausentismos, etc.)
# JWT_RESPUESTA_SECRET=

# ============================================
# CORREOS EN DESARROLLO (global)
# ============================================
# En NODE_ENV=development (o EMAIL_MODO_PRUEBAS=true) todos los correos
# salientes se redirigen a este buzón; el cuerpo indica destinatarios reales.
EMAIL_DEV_OVERRIDE=programador3@codiesel.co
# true | false | omitir (= true si NODE_ENV !== production)
EMAIL_MODO_PRUEBAS=true

# ============================================
# MPVI (cotizaciones taller)
# ============================================
# Secreto para enlaces públicos de firma/PDF del cliente (JWT HS256).
# Si no se define, se usa JWT_RESPUESTA_SECRET como respaldo.
# Generar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_MPVI_LINK_SECRET=mpvi_dev_secret_cambiar_en_produccion_minimo_32_caracteres

# En modo pruebas los correos MPVI NO van al cliente; van a este buzón.
MPVI_CORREO_PRUEBAS=programador3@codiesel.co

# true = correos MPVI solo a MPVI_CORREO_PRUEBAS | false = correo real del cliente
# Si se omite: true en development, false en production
MPVI_MODO_PRUEBAS=true
