# ============================================
# CONFIGURACIÓN DEL BACKEND - Intranet Postventa
# ============================================
# Copia este archivo según tu entorno:
# - Desarrollo local (dev): .env.local
# - Servidor de desarrollo: .env

# ============================================
# BASE DE DATOS (SQL Server)
# ============================================
# Formato: sqlserver://HOST:PORT;database=DB_NAME;user=USER;password=PASSWORD;encrypt=false;trustServerCertificate=true
DATABASE_URL="sqlserver://localhost:1433;database=your_database;user=your_user;password=your_password;encrypt=false;trustServerCertificate=true"

# ============================================
# JWT AUTHENTICATION
# ============================================
# IMPORTANTE: Cambiar esta clave en producción por una clave segura única
# Puedes generar una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_TOKEN_SECRET=your_super_secret_key_change_in_production

# Token de refresh (opcional, descomentar si se necesita)
# JWT_REFRESH_TOKEN_SECRET=your_refresh_secret_key_change_in_production

# Puerta maestra legacy 123456 (solo usuarios con clave AES de CodeIgniter).
# true = habilitada durante el lanzamiento. Apagar a false en 7-14 días.
ALLOW_LEGACY_MASTER_PASSWORD=true

# Smoke autenticado y carga (no subir valores reales al repo)
# SMOKE_NIT=
# SMOKE_PASSWORD=

# Pool SQL Server (150-200 usuarios concurrentes: 20-40 según vCPU del API)
MSSQL_POOL_MAX=30
MSSQL_POOL_MIN=0
MSSQL_REQUEST_TIMEOUT_MS=30000
MSSQL_CONNECTION_TIMEOUT_MS=15000

# ============================================
# SERVIDOR
# ============================================
PORT=4000
NODE_ENV=development

# Origen del frontend permitido por CORS (sin trailing slash)
CORS_ORIGIN=http://localhost:3000

# URL pública del backend (correos: enlaces a /administracion/responder, adjuntos)
APP_URL=http://localhost:4000

# URL del frontend (redirecciones tras autorización por correo)
FRONTEND_URL=http://localhost:3000

# Base CodeIgniter postventa para "Ver Ticket" si el creador es fid_perfil 51–54
# (str_replace postventa → ventas). No usar FRONTEND_URL si es /postventa2.
# TICKETS_LEGACY_BASE_URL=http://localhost:8080/postventa/

# URL pública preferida para enlaces en correos del cotizador (PDF, imágenes).
# Si está vacío, se usa FRONTEND_URL y luego BACKEND_PUBLIC_URL.
# APP_PUBLIC_URL=

# URL pública del backend si los enlaces del correo deben apuntar al API
# BACKEND_PUBLIC_URL=

# JWT para tokens en enlaces de correo (gestión compras, ausentismos, etc.)
# JWT_RESPUESTA_SECRET=

# ============================================
# SMTP POR EMPRESA (From / cuenta Gmail)
# ============================================
# Host/puerto comunes. Credenciales por empresa (App Password, no en código).
# 1 Codiesel · 2 Dieselco · 3 Mitsubishi y 4 BYD (Codinova, SMTP_3)
# Si SMTP_1_* no está, se usan SMTP_USER / SMTP_PASS / SMTP_FROM (compatibilidad).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_1_USER=no-reply@codiesel.co
SMTP_1_PASS=
SMTP_1_FROM=no-reply@codiesel.co
SMTP_1_FROM_NAME=CODIESEL S.A
SMTP_2_USER=no-reply@dieselco.co
SMTP_2_PASS=
SMTP_2_FROM=no-reply@dieselco.co
SMTP_2_FROM_NAME=DIESELCO S.A
SMTP_3_USER=no-reply@codinovamotor.com
SMTP_3_PASS=
SMTP_3_FROM=no-reply@codinovamotor.com
SMTP_3_FROM_NAME=CODINOVA S.A
# SMTP_USER / SMTP_PASS / SMTP_FROM / SMTP_FROM_NAME siguen valiendo como fallback de empresa 1


# Gestión compras — mismos buzones que Compras.php (Codiesel).
# Autorización (solicitar_autorizacion). Override opcional; si se omite usa estos 3.
EMAIL_AUTORIZACION_COMPRAS=personal@codiesel.co,gerencia@codiesel.co,ger.servicio@codiesel.co
# Alta de solicitud (insert_solicitud). Override opcional; si se omite: compras@codiesel.co
EMAIL_NUEVA_SOLICITUD_COMPRAS=compras@codiesel.co

# ============================================
# CORREOS — MODO PRUEBAS (global, todos los módulos)
# ============================================
# Kill-switch: TODOS los envíos SMTP (to/cc/bcc) se redirigen a EMAIL_DEV_OVERRIDE.
# El cuerpo del correo lista los destinatarios originales. No salen a clientes.
#
# true  = redirigir (también con NODE_ENV=production y BD de producción)
# false = destinatarios reales
# omitir = true si NODE_ENV !== production; false si NODE_ENV=production
#
# PRUEBAS CON BD DE PRODUCCIÓN:
#   NODE_ENV=production + EMAIL_MODO_PRUEBAS=true
# OPERACIÓN REAL:
#   EMAIL_MODO_PRUEBAS=false
EMAIL_DEV_OVERRIDE=programador3@codiesel.co
EMAIL_MODO_PRUEBAS=true

# ============================================
# MPVI (cotizaciones taller)
# ============================================
# Secreto para enlaces públicos de firma/PDF del cliente (JWT HS256).
# Si no se define, se usa JWT_RESPUESTA_SECRET como respaldo.
# Generar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_MPVI_LINK_SECRET=mpvi_dev_secret_cambiar_en_produccion_minimo_32_caracteres

# En modo pruebas los correos MPVI NO van al cliente; van a este buzón.
# Si EMAIL_MODO_PRUEBAS=true, MPVI también redirige aunque esto esté en false.
MPVI_CORREO_PRUEBAS=programador3@codiesel.co

# true = correos MPVI solo a EMAIL_DEV_OVERRIDE / MPVI_CORREO_PRUEBAS
# false = correo real del cliente (salvo que EMAIL_MODO_PRUEBAS=true)
# Si se omite: true en development, false en production
MPVI_MODO_PRUEBAS=true
