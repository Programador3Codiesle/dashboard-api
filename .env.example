# ============================================
# CONFIGURACIÓN DEL BACKEND - Intranet Postventa
# ============================================
# Copia este archivo a .env y configura las variables según tu entorno

# ============================================
# BASE DE DATOS (SQL Server)
# ============================================
# Formato: sqlserver://HOST:PORT;database=DB_NAME;user=USER;password=PASSWORD;encrypt=false;trustServerCertificate=true
DATABASE_URL="sqlserver://localhost:1433;database=your_database;user=your_user;password=your_password;encrypt=false;trustServerCertificate=true"

# ============================================
# JWT AUTHENTICATION
# ============================================
# IMPORTANTE: Cambiar esta clave en producción por una clave segura única
# Puedes generar una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_TOKEN_SECRET=your_super_secret_key_change_in_production

# Token de refresh (opcional, descomentar si se necesita)
# JWT_REFRESH_TOKEN_SECRET=your_refresh_secret_key_change_in_production

# ============================================
# SERVIDOR
# ============================================
PORT=3001
NODE_ENV=development
